# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

APP_NAME=mini-ats-backend
ENVIRONMENT=development

# Required - the app fails to start without these (see app/core/config.py).
# Find SUPABASE_URL under Project Settings -> API. JWKS URL is that same
# project URL + /auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWKS_URL=

# Required - the service-role key (Project Settings -> API Keys). Used for
# every jobs/candidates database read and write (bypasses RLS; FastAPI
# enforces ownership itself) and, from step 6, admin account creation.
# Never log it or return it in a response.
SUPABASE_SECRET_KEY=
